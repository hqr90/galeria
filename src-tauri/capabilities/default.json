{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidades padrao de IO e janelas do FrameCast",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "**"]
    }
  ]
}
